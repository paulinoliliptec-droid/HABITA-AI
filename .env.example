# HABITA AI — environment template
# Copy to `.env` (backend) / `frontend/.env.local` (frontend) and fill in locally.
# PLACEHOLDERS ONLY. Never commit real values. In Cloud Run, inject these from
# Secret Manager instead of files. See docs/environment.md for details.

# --- MongoDB Atlas (project: "HABITA AI") ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=habita_ai
# Local dev/tests only: allow a process-local store when MONGODB_URI is unset.
# Never set in a deployment (the backend then refuses to start without MongoDB).
# ALLOW_EPHEMERAL_STORAGE=true

# --- Meta Model API ---
META_API_KEY=<meta-model-api-key>
META_API_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
META_SEGMENTATION_MODEL=sam-3.1

# --- Google Maps Platform ---
# Server-side key (Geocoding, Places, etc.). Restrict by API + IP/service.
GOOGLE_MAPS_API_KEY=<server-side-maps-key>
# Optional: dedicated key for the PDF location images (Maps Static + Street View Static only; no fallback)
MAPS_STATIC_API_KEY=
# Dedicated server key restricted to the Cloud Translation API. Unset: HABITA still works, in English.
GOOGLE_TRANSLATE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_PT=
# Browser key (Maps JavaScript API). Exposed to the client by design —
# restrict by HTTP referrer and to the Maps JavaScript API only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<browser-maps-key>

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=<gcp-project-id>
GOOGLE_CLOUD_REGION=us-central1
ARTIFACT_REGISTRY_REPO=habita
CLOUD_RUN_BACKEND_SERVICE=habita-backend
CLOUD_RUN_FRONTEND_SERVICE=habita-frontend
# Local dev only, if not using `gcloud auth application-default login`.
# Point at a key file OUTSIDE the repo. Leave unset on Cloud Run.
# GOOGLE_APPLICATION_CREDENTIALS=/path/outside/repo/key.json

# --- App wiring ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:3000
APP_ENV=development
